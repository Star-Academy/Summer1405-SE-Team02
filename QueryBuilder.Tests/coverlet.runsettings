<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[QueryBuilder]QueryBuilder.Program,[QueryBuilder]QueryBuilder.Constants.Messages</Exclude>
          <ExcludeByFile>**/Program.cs,**/Constants/Messages.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>